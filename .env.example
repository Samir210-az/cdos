# Bu fayl nümunədir. Real .env DB-yə commit edilmir (.gitignore-da).

NODE_ENV=development

# --- PostgreSQL: MIGRATOR rolu (BYPASSRLS) --- yalnız migration/seed skriptləri istifadə edir
DATABASE_MIGRATOR_URL=postgres://cdos_migrator:CHANGE_ME@localhost:5432/cdos

# --- PostgreSQL: APP rolu (RLS-ə tabedir) --- backend application yalnız bunu istifadə edir
DATABASE_APP_URL=postgres://cdos_app:CHANGE_ME@localhost:5432/cdos

# --- JWT ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Redis (Faz 3.1 Fix#2 scope cache) ---
# Bu fazda Redis MÖVCUD DEYİL. REDIS_URL boş buraxılarsa,
# sistem avtomatik InMemoryScopeCacheAdapter-ə keçir (bax src/scope-cache).
REDIS_URL=

APP_PORT=3000
